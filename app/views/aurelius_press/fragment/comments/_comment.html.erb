<div class="comment" id="<%= dom_id(comment) %>">
  <div class="comment-header">
    <strong><%= comment.user.full_name %></strong>
    <span class="comment-date"><%= time_ago_in_words(comment.created_at) %> ago</span>
  </div>

  <article class="comment-content">
    <%= comment.content %>
  </article>

  <div class="comment-engagement">
    <%= render partial: "aurelius_press/community/shared/engagement_bar", locals: { interactable: comment } %>
  </div>

  <% if user_signed_in? && current_user == comment.user %>
    <%
      commentable_key = comment.commentable.class.name.demodulize.underscore
      delete_path = send(:"aurelius_press_#{commentable_key}_comment_path", comment.commentable, comment)
    %>
    <div class="comment-actions">
      <%= link_to "Delete", delete_path,
          data: { turbo_method: :delete, turbo_confirm: "Delete this comment?" },
          class: "comment-delete" %>
    </div>
  <% end %>

  <% if comment.replies.any? %>
    <div class="comment-replies">
      <%= render comment.replies %>
    </div>
  <% end %>
</div>
